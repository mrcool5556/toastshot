<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme. Same keys as Light.xaml; ThemeManager swaps the two. Values come from the Toastshot design system. -->
    <!-- Window background. -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF141416"/>
    <!-- Toolbars, action bar, side panel, cards, menus, tooltips, floating chips. -->
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FF1C1C1F"/>
    <!-- Text fields, selects, checkboxes. -->
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#FF0F0F11"/>
    <!-- Behind the screenshot / GIF. No text on it. -->
    <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="#FF0B0B0D"/>
    <!-- Default button and tile fill. -->
    <SolidColorBrush x:Key="ControlBrush" Color="#FF2A2A2E"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FF333338"/>
    <SolidColorBrush x:Key="ControlPressBrush" Color="#FF3D3D43"/>
    <!-- Button and tile border; toolbar dividers. -->
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF45454C"/>
    <!-- Hairlines between regions. -->
    <SolidColorBrush x:Key="LineBrush" Color="#FF2C2C31"/>
    <!-- Field borders, slider track (3:1 on every surface). -->
    <SolidColorBrush x:Key="LineStrongBrush" Color="#FF6B6B74"/>
    <!-- Primary text. -->
    <SolidColorBrush x:Key="InkBrush" Color="#FFEDEDEF"/>
    <!-- Secondary text: hints, labels, status (4.5:1 on every surface). -->
    <SolidColorBrush x:Key="InkMutedBrush" Color="#FFA1A1AA"/>
    <!-- Primary buttons, selection, focus ring. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4FC3F7"/>
    <!-- Selected tool and menu row. -->
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#334FC3F7"/>
    <!-- Text on an accent fill. -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FF0B1220"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="#FF4FC3F7"/>
    <SolidColorBrush x:Key="StatusOkBrush" Color="#FF66BB6A"/>
    <SolidColorBrush x:Key="StatusWarnBrush" Color="#FFF2B84B"/>
    <!-- Error text and the not-reachable dot. -->
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#FFEF5350"/>
    <!-- Live recording only. -->
    <SolidColorBrush x:Key="StatusRecordBrush" Color="#FFEF5350"/>
    <SolidColorBrush x:Key="OnRecordBrush" Color="#FF0B1220"/>

    <!-- The capture overlay draws on screen content, so it is the same in both themes. -->
    <SolidColorBrush x:Key="OverlayScrimBrush" Color="#8C000000"/>
    <SolidColorBrush x:Key="OverlaySelectionBrush" Color="#FF4FC3F7"/>
    <SolidColorBrush x:Key="OverlayCrosshairBrush" Color="#99FFFFFF"/>

    <!-- Only things floating over other apps or the window get a shadow. -->
    <DropShadowEffect x:Key="FloatShadow" Color="Black" Direction="270" ShadowDepth="8" BlurRadius="24" Opacity="0.5"/>
    <DropShadowEffect x:Key="PopupShadow" Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/>
</ResourceDictionary>
