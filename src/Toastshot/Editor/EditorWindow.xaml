<Window x:Class="Toastshot.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:toastshot="clr-namespace:Toastshot"
        Style="{StaticResource AppWindow}"
        Title="Toastshot — Screenshot"
        Width="1040" Height="720" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: drawing only. Outputs live in the action bar at the bottom. -->
        <Border Grid.Row="0" Style="{StaticResource Toolbar}">
            <WrapPanel VerticalAlignment="Center">
                <RadioButton x:Name="PenTool" Style="{StaticResource ToolButton}" GroupName="Tool" Content="Pen" Tag="Pen" toastshot:Ui.Key="P" Checked="OnToolChecked" IsChecked="True" ToolTip="Freehand pen (P)"/>
                <RadioButton Style="{StaticResource ToolButton}" GroupName="Tool" Content="Marker" Tag="Marker" toastshot:Ui.Key="M" Checked="OnToolChecked" ToolTip="See-through highlighter (M)"/>
                <RadioButton Style="{StaticResource ToolButton}" GroupName="Tool" Content="Line" Tag="Line" toastshot:Ui.Key="L" Checked="OnToolChecked" ToolTip="Straight line; hold Shift for 45° steps (L)"/>
                <RadioButton Style="{StaticResource ToolButton}" GroupName="Tool" Content="Arrow" Tag="Arrow" toastshot:Ui.Key="A" Checked="OnToolChecked" ToolTip="Arrow; hold Shift for 45° steps (A)"/>
                <RadioButton Style="{StaticResource ToolButton}" GroupName="Tool" Content="Box" Tag="Box" toastshot:Ui.Key="B" Checked="OnToolChecked" ToolTip="Rectangle outline; hold Shift for a square (B)"/>
                <RadioButton Style="{StaticResource ToolButton}" GroupName="Tool" Content="Oval" Tag="Oval" toastshot:Ui.Key="O" Checked="OnToolChecked" ToolTip="Ellipse outline; hold Shift for a circle (O)"/>
                <RadioButton Style="{StaticResource ToolButton}" GroupName="Tool" Content="Text" Tag="Text" toastshot:Ui.Key="T" Checked="OnToolChecked" ToolTip="Click to type; Enter to finish, Shift+Enter for a new line (T)"/>
                <RadioButton Style="{StaticResource ToolButton}" GroupName="Tool" Content="Redact" Tag="Redact" toastshot:Ui.Key="R" Checked="OnToolChecked" ToolTip="Solid black box to hide private details (R)"/>
                <!-- Each group wraps as a unit so a control never ends up apart from its divider. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="28">
                    <Rectangle Style="{StaticResource Divider}"/>
                    <StackPanel x:Name="Swatches" Orientation="Horizontal" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="28" ToolTip="Line width / text size">
                    <Rectangle Style="{StaticResource Divider}"/>
                    <Slider x:Name="SizeSlider" Width="80" Minimum="1" Maximum="24" Value="4" IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" ValueChanged="OnSizeChanged"/>
                    <TextBlock x:Name="SizeText" Text="4" Width="22" Margin="8,0,0,0" Style="{StaticResource MonoText}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="28">
                    <Rectangle Style="{StaticResource Divider}"/>
                    <Button x:Name="UndoButton" Content="Undo" Style="{StaticResource GhostCompactButton}" Click="OnUndo" IsEnabled="False" ToolTip="Ctrl+Z"/>
                    <Button x:Name="RedoButton" Content="Redo" Style="{StaticResource GhostCompactButton}" Click="OnRedo" IsEnabled="False" ToolTip="Ctrl+Y"/>
                    <Button x:Name="ClearButton" Content="Clear" Style="{StaticResource GhostCompactButton}" Click="OnClear" IsEnabled="False" ToolTip="Remove all drawings"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Canvas + text panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="SideColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceCanvasBrush}" ClipToBounds="True">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="20">
                    <Grid x:Name="Surface">
                        <Image x:Name="BaseImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Canvas x:Name="Ink" Background="Transparent" ClipToBounds="True" Cursor="Cross"
                                MouseLeftButtonDown="OnInkDown" MouseMove="OnInkMove" MouseLeftButtonUp="OnInkUp"/>
                    </Grid>
                </Viewbox>
            </Border>

            <Border x:Name="SidePanel" Grid.Column="1" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1,0,0,0" Padding="16" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}" Click="OnCloseSide" ToolTip="Hide panel"/>
                        <TextBlock Text="Text in image" Style="{StaticResource CardTitle}"/>
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button x:Name="RereadButton" DockPanel.Dock="Right" Content="Read" Margin="8,0,0,0" Click="OnExtractText" ToolTip="Read the image again with the selected reader"/>
                        <ComboBox x:Name="ReaderBox" ToolTip="Windows OCR is instant and offline. AI vision uses your Ollama vision model (slower; good for handwriting or stylised text)."/>
                    </DockPanel>
                    <TextBox x:Name="OcrText" Grid.Row="2" Style="{StaticResource EditorBox}" MinHeight="80"
                             ToolTip="You can edit this before translating"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="-10,4,0,16">
                        <Button Content="Copy text" Style="{StaticResource GhostCompactButton}" Click="OnCopyOcrText"/>
                    </StackPanel>

                    <TextBlock x:Name="TranslationHeader" Grid.Row="4" Text="Translation" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                    <DockPanel x:Name="TranslationControls" Grid.Row="5" Margin="0,0,0,8">
                        <Button x:Name="SideTranslateButton" DockPanel.Dock="Right" Content="Translate" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OnTranslate"/>
                        <ComboBox x:Name="LanguageBox" IsEditable="True" ToolTip="Language to translate into (type any language)"/>
                    </DockPanel>
                    <TextBox x:Name="TranslationText" Grid.Row="6" Style="{StaticResource EditorBox}" MinHeight="80" IsReadOnly="True"/>
                    <StackPanel x:Name="TranslationCopy" Grid.Row="7" Orientation="Horizontal" Margin="-10,4,0,0">
                        <Button Content="Copy translation" Style="{StaticResource GhostCompactButton}" Click="OnCopyTranslation"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Action bar: what just happened on the left; outputs on the right, Copy last. -->
        <Border Grid.Row="2" Style="{StaticResource ActionBar}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ReadButton" Content="Extract text" Style="{StaticResource CompactButton}" Margin="0,0,8,0" Click="OnExtractText" ToolTip="Turn the image into text (Ctrl+E)"/>
                    <Button x:Name="TranslateButton" Content="Translate" Style="{StaticResource CompactButton}" Margin="0,0,8,0" Click="OnTranslate" ToolTip="Read the text and translate it (Ctrl+T)"/>
                    <Button Content="Search Google" Style="{StaticResource CompactButton}" Click="OnSearchGoogle" ToolTip="Find similar images with Google Lens (uploads the image to Google; Ctrl+G)"/>
                    <Rectangle Style="{StaticResource Divider}"/>
                    <Button Content="Print…" Style="{StaticResource CompactButton}" Margin="0,0,8,0" Click="OnPrint" ToolTip="Print (Ctrl+P)"/>
                    <Button x:Name="SaveButton" Content="Save…" Style="{StaticResource CompactButton}" Margin="0,0,8,0" Click="OnSave" ToolTip="Save as PNG, JPEG or BMP (Ctrl+S)"/>
                    <Button x:Name="CopyButton" Content="Copy" Style="{StaticResource PrimaryCompactButton}" Click="OnCopy" ToolTip="Copy the image to the clipboard (Ctrl+C)"/>
                </StackPanel>
                <TextBlock x:Name="SizeInfo" DockPanel.Dock="Right" Style="{StaticResource MonoText}" Margin="12,0,16,0"/>
                <Button x:Name="StopButton" DockPanel.Dock="Right" Content="Stop" Style="{StaticResource GhostCompactButton}" Margin="8,0,0,0"
                        Visibility="Collapsed" Click="OnStop"/>
                <TextBlock x:Name="Status" Foreground="{DynamicResource InkBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="Draw on the image, then copy, save, extract text or translate."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
