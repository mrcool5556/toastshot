<Window x:Class="Toastshot.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Update Toastshot"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <!-- What's new since this copy: every release you skipped, newest first, then one button. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LaterButton" Content="Later" Style="{StaticResource GhostButton}" Margin="0,0,8,0" IsCancel="True" Click="OnLater"/>
                <Button x:Name="UpdateButton" Content="Update now" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnUpdate"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="24,20,24,20">
            <TextBlock x:Name="Heading" Style="{StaticResource WindowTitle}" FontSize="18"/>
            <TextBlock x:Name="Subheading" Style="{StaticResource Hint}" Margin="0,4,0,14"/>
            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel x:Name="Releases"/>
            </ScrollViewer>

            <StackPanel x:Name="ProgressPanel" Margin="0,16,0,0" Visibility="Collapsed">
                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="ProgressDetail" DockPanel.Dock="Right" Style="{StaticResource MonoText}"/>
                    <TextBlock x:Name="ProgressText" Style="{StaticResource Body}"/>
                </DockPanel>
                <ProgressBar x:Name="Progress" Minimum="0" Maximum="1"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,12,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </DockPanel>
</Window>
