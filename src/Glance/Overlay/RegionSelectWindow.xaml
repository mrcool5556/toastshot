<Window x:Class="Glance.Overlay.RegionSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glance selection"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="Cross"
        Focusable="True"
        UseLayoutRounding="True">
    <!-- Scrim, outline and crosshair draw over screen content, so they don't follow the theme; the chips do. -->
    <Grid x:Name="Root">
        <Image x:Name="Frozen" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False"/>
        <!-- The screen dimmed everywhere, and undimmed only inside the selection (a clipped copy), so dragging only
             redraws around the selection. -->
        <Rectangle Fill="{DynamicResource OverlayScrimBrush}" IsHitTestVisible="False"/>
        <Image x:Name="Bright" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False"/>
        <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
            <Rectangle x:Name="SelectionRect" Stroke="{DynamicResource OverlaySelectionBrush}" StrokeThickness="1.5" Visibility="Collapsed"/>
            <Border x:Name="SizeBadge" Style="{StaticResource SizeBadge}" Visibility="Collapsed">
                <TextBlock x:Name="SizeText" Foreground="{DynamicResource InkBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="12"/>
            </Border>
        </Canvas>
        <Canvas x:Name="Crosshair" IsHitTestVisible="False">
            <Line x:Name="CrossV" Stroke="{DynamicResource OverlayCrosshairBrush}" StrokeThickness="1"/>
            <Line x:Name="CrossH" Stroke="{DynamicResource OverlayCrosshairBrush}" StrokeThickness="1"/>
        </Canvas>
        <Border x:Name="HintBar" Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="HintText" Text="Drag to select a region" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                           FontSize="13" FontFamily="{DynamicResource UiFont}" VerticalAlignment="Center"/>
                <ContentControl Content="Esc" ContentTemplate="{StaticResource KeycapTemplate}" Margin="10,0,4,0" VerticalAlignment="Center" Focusable="False"/>
                <TextBlock Text="or right-click to cancel" Foreground="{DynamicResource InkMutedBrush}"
                           FontSize="13" FontFamily="{DynamicResource UiFont}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
