<Window x:Class="Glance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Glance"
        Width="440" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <!-- Two big buttons, a row of quiet ones, and a status line along the bottom. The title bar names the window. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,10,20,12">
            <StackPanel>
                <DockPanel>
                    <Ellipse x:Name="OllamaDot" Width="8" Height="8" Fill="{DynamicResource InkMutedBrush}" VerticalAlignment="Top" Margin="0,4,8,0"/>
                    <TextBlock x:Name="OllamaStatus" Style="{StaticResource Hint}" Text="Checking Ollama…"/>
                </DockPanel>
                <TextBlock x:Name="HotkeyWarning" Style="{StaticResource Hint}" Foreground="{DynamicResource StatusWarnBrush}" Margin="16,4,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="20,16,20,16">
            <!-- Shown only when a newer Glance is out. -->
            <Border x:Name="UpdateStrip" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="10" Padding="14,8,8,8" Margin="0,0,0,12" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="See what's new" Style="{StaticResource PrimaryCompactButton}" Click="OnSeeUpdate"/>
                    <TextBlock x:Name="UpdateText" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource ActionTile}" Height="112" Click="OnCapture" ToolTip="Drag a box; it stays on screen to mark up, copy, save, read or translate">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Top" Text="Capture" Style="{StaticResource ActionText}" FontSize="17"/>
                        <TextBlock DockPanel.Dock="Top" Text="Screenshot a region" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                        <ItemsControl x:Name="CaptureKeys" DockPanel.Dock="Bottom" Style="{StaticResource Keycaps}"/>
                    </DockPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource ActionTile}" Height="112" Click="OnGif" ToolTip="Drag a box, then record it; press the hotkey again to stop">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Top" Text="Record GIF" Style="{StaticResource ActionText}" FontSize="17"/>
                        <TextBlock DockPanel.Dock="Top" Text="Record a region" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                        <ItemsControl x:Name="GifKeys" DockPanel.Dock="Bottom" Style="{StaticResource Keycaps}"/>
                    </DockPanel>
                </Button>
            </Grid>

            <DockPanel Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Settings" Style="{StaticResource GhostButton}" Click="OnSettings"/>
                    <Button Content="Quit" Style="{StaticResource GhostButton}" Click="OnQuit" ToolTip="Exit Glance completely (closing the window keeps it in the notification area)"/>
                </StackPanel>
                <Button Content="Open image…" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-10,0,0,0" Click="OnOpen" ToolTip="Edit, read or translate an existing image, or play a GIF"/>
            </DockPanel>
        </StackPanel>
    </DockPanel>
</Window>
